OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=your_chat_model
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Local development. Docker Compose forces DJANGO_DEBUG=false and requires a key.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://rag.example.com
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_TRUST_PROXY_SSL_HEADER=true
# DJANGO_API_USER_RATE=120/min
# DJANGO_API_ASK_RATE=10/min

# Leave CHROMA_HOST empty to use the persistent local database at CHROMA_PATH.
CHROMA_PATH=chroma_db
CHROMA_COLLECTION=document_chunks
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
# CHROMA_SSL=false

CHROMA_BATCH_SIZE=128
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_RETRIES=3
